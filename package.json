{
  "name": "sats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm i && icp deploy",
    "start": "vite --port 3000",
    "bindings": "icp-bindgen --did-file ./backend/backend.did --out-dir ./src/bindings --force && icp-bindgen --did-file ./candid/ckbtc.did --out-dir ./src/bindings --force",
    "build": "npm run bindings && tsc && vite build",
    "test": "run-s test:backend test:frontend",
    "test:backend": "mops test",
    "test:frontend": "npm run bindings && vitest run",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss}\" \"backend/**/*.mo\"",
    "postinstall": "mops install"
  },
  "dependencies": {
    "@icp-sdk/auth": "^8.0.3",
    "@icp-sdk/core": "^5.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@icp-sdk/bindgen": "^0.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.1",
    "cross-fetch": "^3.1.6",
    "fake-indexeddb": "^6.2.5",
    "ic-mops": "^3.1.0",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "prettier-plugin-motoko": "^0.5.3",
    "terser": "^5.30.3",
    "typescript": "^5.1.3",
    "vite": "^4.3.9",
    "vitest": "^0.32.2"
  }
}
